{
    "name": "janalis/porta-git",
    "description": "Git features that do not need the workbench: blame annotations",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "symfony/event-dispatcher": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\GitPlugin\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "requires": [
                "diff"
            ],
            "tools": [
                {
                    "name": "git",
                    "purpose": "every git feature",
                    "setting": "path",
                    "sources": [
                        [
                            "brew",
                            "git"
                        ]
                    ]
                },
                {
                    "name": "gh",
                    "role": "suggested",
                    "purpose": "pull-request numbers beside the branch",
                    "sources": [
                        [
                            "brew",
                            "gh"
                        ]
                    ]
                }
            ]
        }
    }
}
